{
  "name": "zion-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/admin",
      "/admin/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zion",
      "database_id": "1d5194e4-0be4-4f9c-a245-eee72b472743"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zion"
    }
  ],
  "vars": {
    "INFINITEPAY_HANDLE": "zion-clothing",
    "ADMIN_ALLOWED_EMAIL": "ianlucas.fm@icloud.com",
    "ADMIN_ACCESS_TEAM_DOMAIN": "https://patient-thunder-76be.cloudflareaccess.com",
    "ADMIN_ACCESS_AUD": "3cba86e1d617b97da6b31649e0be128be7fb2595fd84178f6e2b628b4f1f5470"
  }
}
