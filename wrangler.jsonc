{
  "name": "zion-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zion",
      "database_id": "1d5194e4-0be4-4f9c-a245-eee72b472743"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "zion"
    }
  ]
}